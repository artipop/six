    "not started" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "не запущен"
          }
        }
      }
    },
    "Nothing in the registry matches." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В реестре ничего не нашлось."
          }
        }
      }
    },
    "Nothing is built and nothing is injected into a page: no ⌘K line, no bar over a selection, no agent, no socket. Bookmark search and page translation are not affected." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не строится и в страницу ничего не внедряется: ни строки ⌘K, ни полоски над выделением, ни агента, ни сокета. Поиска по закладкам и перевода страниц это не касается."
          }
        }
      }
    },
    "Nothing is kept in this profile. Closing it forgets the session." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом профиле ничего не сохраняется. Закройте его — и сессия забыта."
          }
        }
      }
    },
    "npx -y @modelcontextprotocol/server-map --stdio" : {
