<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- An app extension on macOS runs sandboxed or not at all. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The one file outside the container the sheet reads: the row as six wrote it down, so a
	     workspace can be offered by name. Read-only, and that one file rather than the folder —
	     the database and the snapshot beside it are none of the extension's business. A temporary
	     exception rather than an App Group because a group needs a developer team, and this
	     machine signs ad hoc. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/$(SIX_APP_IDENTIFIER)/share-targets.json</string>
	</array>
</dict>
</plist>
